// Animation player for the player model. The animations themselves are
// clips in anim/clips/*.json, made with the editor (tools/anim_editor) and
// sampled into anim_data.tc by tools/anim_clips.py. This file only picks which clip plays, finds
// the time in it, and crossfades between clips.
//
// Which clip plays:
//   in the air     jump (rising), fall
//   just landed    land
//   moving         crouch (sneaking), run (sprinting), walk; these
//                  are cycles driven by the distance walked, so the steps
//                  match the speed
//   standing       crouchIdle (sneaking), stance (holding an item), idle
//   on top         an attack (w1..w3 with an item, f1..f3 without; clicking
//                  during a swing chains the next hit of the combo) or an
//                  emote (@e NAME; moving or jumping stops it)
// Walking with an item, the weapon arm comes from the "hold" clip.
//
// When the clip changes, the pose crossfades from where it was to the new
// clip over that clip's fade ticks. The head then looks where the player
// looks (within what a neck allows), on top of the animation.

/** Per player UUID: feet position last tick, cycle phase (0..1), the
 * player's own animation clock (ticks), ticks left counted as in the air,
 * ticks spent in the air, ticks left of landing. */
declare global animPrev: dict[vec];
declare global animPhase: dict[num];
declare global animClock: dict[num];
declare global animAir: dict[num];
declare global animAirT: dict[num];
declare global animLand: dict[num];
/** Per player UUID: the emote playing and its tick. */
declare global animEmote: dict[str];
declare global animEmoteT: dict[num];
/** Per player UUID: the attack playing and its tick, 1 when the next combo
 * hit is queued, the clock tick the last attack ended and its combo step. */
declare global animAct: dict[str];
declare global animActT: dict[num];
declare global animNext: dict[num];
declare global animActEnd: dict[num];
declare global animStep: dict[num];
/** Per player UUID: present while @animdebug shows the clip and inputs. */
declare global animDebug: dict[num];
/** Per player UUID: the clip playing, the pose the crossfade started from,
 * ticks since it started, and the animated pose (before the head look). */
declare global animClipNow: dict[str];
declare global animFrom: dict[dict];
declare global animFadeT: dict[num];
declare global animOut: dict[dict];

/** Horizontal speed (blocks per tick): above the first the player walks;
 * above the second (faster than normal walking, 0.215), or sprinting
 * (0.28), runs. */
function animWalkMin(): num {
    return 0.03;
}

function animRunMin(): num {
    return 0.25;
}

/** Ticks after an attack in which a click still continues the combo. */
function animComboGap(): num {
    return 12;
}

/** Ticks of the landing clip (as in anim_clips.py). */
function animLandTicks(): num {
    return 7;
}

/** Forgets player `uuid`'s animation state. */
function animForget(uuid: str) {
    global animPrev.remove(uuid);
    global animPhase.remove(uuid);
    global animClock.remove(uuid);
    global animAir.remove(uuid);
    global animAirT.remove(uuid);
    global animLand.remove(uuid);
    global animEmote.remove(uuid);
    global animEmoteT.remove(uuid);
    global animAct.remove(uuid);
    global animActT.remove(uuid);
    global animNext.remove(uuid);
    global animActEnd.remove(uuid);
    global animStep.remove(uuid);
    global animClipNow.remove(uuid);
    global animFrom.remove(uuid);
    global animFadeT.remove(uuid);
    global animOut.remove(uuid);
}

/** A number from per-player dict `d`, or `def` when it has none. */
function animGet(d: dict, uuid: str, def: num): num {
    if (d.hasKeys(uuid)) {
        return d[uuid] as num;
    }
    return def;
}

/** Angle a wrapped into -180..180. */
function animWrap(a: num): num {
    line out = a;
    while (line out > 180) {
        line out = line out - 360;
    }
    while (line out < -180) {
        line out = line out + 360;
    }
    return line out;
}

/** Loads the clip data when this code's version is not loaded yet. */
function animEnsure {
    if (global animVer != animVersion()) {
        loadClips();
    }
}

/** Clip `name`'s samples as numbers (parsed once). */
function animSamples(name: str): list {
    if (!global animData.hasKeys(name)) {
        line out = [];
        for (line v of (global animStr[name] as str).split(",")) {
            line out.append(num.parse(line v as str));
        }
        global animData[name] = line out;
    }
    return global animData[name] as list;
}

/** Clip `name`'s pose at u (once: 0..1, held at the ends; loop and cycle:
 * wraps), between the two nearest samples. */
function animSampleAt(name: str, u: num): dict {
    line meta = global animMeta[name] as list;
    line n = meta[1] as num;
    line data = animSamples(name);
    line i0 = 0;
    line i1 = 0;
    line w = 0;
    if (meta[2] as num == 0) {
        line x = num.clamp(u, 0, 1) * (line n - 1);
        line i0 = num.floor(line x);
        line i1 = num.min(line i0 + 1, line n - 1);
        line w = line x - line i0;
    } else {
        line x = (u - num.floor(u)) * line n;
        line i0 = num.floor(line x) % line n;
        line i1 = (line i0 + 1) % line n;
        line w = line x - num.floor(line x);
    }
    line a = line i0 * 36;
    line b = line i1 * 36;
    line pose = {};
    line j = 0;
    for (line name2 of animJoints()) {
        line ka = line a + line j * 3;
        line kb = line b + line j * 3;
        line va = vec(line data[line ka + 1] as num, line data[line ka + 2] as num, line data[line ka + 3] as num);
        line vb = vec(line data[line kb + 1] as num, line data[line kb + 2] as num, line data[line kb + 3] as num);
        line pose[line name2 as str] = line va + (line vb - line va) * line w;
        line j = line j + 1;
    }
    return line pose;
}

/** Starts emote `name` for player `uuid`. */
function animPlayEmote(uuid: str, name: str) {
    global animEmote[uuid] = name;
    global animEmoteT[uuid] = 0;
}

/** A left click by player `uuid`: starts an attack, or queues the next hit
 * of the combo when one is already swinging. `armed` 1 with an item. */
function animAttack(uuid: str, armed: num) {
    line kind = "f";
    if (armed == 1) {
        line kind = "w";
    }
    if (global animAct.hasKeys(uuid)) {
        // past the wind-up: the next click chains
        if (global animActT[uuid] >= 2) {
            global animNext[uuid] = 1;
        }
        return;
    }
    // within the gap after the last hit: the combo goes on
    line step = 1;
    line clock = animGet(global animClock, uuid, 0);
    if (global animActEnd.hasKeys(uuid)) {
        if (line clock - global animActEnd[uuid] <= animComboGap()) {
            line step = animGet(global animStep, uuid, 0) % 3 + 1;
        }
    }
    animStartHit(uuid, "%var(kind)%var(step)");
}

/** Starts attack `name` (e.g. "w2") for player `uuid`. */
function animStartHit(uuid: str, name: str) {
    global animAct[uuid] = name;
    global animActT[uuid] = 0;
    global animNext[uuid] = 0;
    global animEmote.remove(uuid);
}

/** Clip `name`'s length: ticks, or blocks per cycle. */
function animLen(name: str): num {
    return (global animMeta[name] as list)[3] as num;
}

/** 1 when `it` (a hand item) is something, not an empty hand. (Is Holding
 * Item with no item counts an empty hand too.) */
function animHoldsItem(it: item): num {
    line m = it.getMaterial();
    if (line m == "air" || line m == "") {
        return 0;
    }
    return 1;
}

/** One tick of player `uuid`'s animation: `feet` is where they stand;
 * `grounded`, `holding` (an item in the main hand), `sneak` and `sprint` are
 * 1 or 0; `look` is (pitch, yaw, 0) of the player's view. */
function animTick(uuid: str, feet: vec, grounded: num, holding: num, sneak: num, sprint: num, look: vec) {
    if (!global rigPose.hasKeys(uuid)) {
        return;
    }
    animEnsure();
    line clock = animGet(global animClock, uuid, 0) + 1;
    global animClock[uuid] = line clock;
    line prev = feet;
    if (global animPrev.hasKeys(uuid)) {
        line prev = global animPrev[uuid];
    }
    global animPrev[uuid] = feet;
    line d = feet - line prev;
    line speed = vec(line d.x, 0, line d.z).len();
    // (a teleport is not a step)
    if (line speed > 2 || num.abs(line d.y) > 2) {
        line speed = 0;
        line d = vec(0, 0, 0);
    }

    // In the air: not grounded, or rising or falling (Is Grounded alone
    // misses jumps); held 3 ticks so the pose holds over the top of a jump.
    // Touching down starts the landing.
    line air = animGet(global animAir, uuid, 0);
    line airT = animGet(global animAirT, uuid, 0);
    line land = num.max(animGet(global animLand, uuid, 0) - 1, 0);
    if (grounded == 0 || num.abs(line d.y) > 0.02) {
        if (line air == 0) {
            line airT = 0;
        }
        line air = 3;
        line airT = line airT + 1;
    } else if (line air > 0) {
        line air = line air - 1;
        if (line air == 0) {
            line land = animLandTicks();
        }
    }
    global animAir[uuid] = line air;
    global animAirT[uuid] = line airT;
    global animLand[uuid] = line land;

    // The base clip and the time in it.
    line clip = "idle";
    line u = 0;
    line moving = 1;
    if (line air > 0) {
        if (line d.y > 0) {
            line clip = "jump";
            line u = line airT / animLen("jump");
        } else {
            line clip = "fall";
            line u = line clock / animLen("fall");
        }
    } else if (line land > 0) {
        line clip = "land";
        line u = (animLandTicks() - line land) / animLandTicks();
    } else if (line speed > animWalkMin()) {
        line clip = "walk";
        if (sneak == 1) {
            line clip = "crouch";
        } else if (line speed > animRunMin() || sprint == 1) {
            line clip = "run";
        }
        line u = (animGet(global animPhase, uuid, 0) + line speed / animLen(line clip)) % 1;
        global animPhase[uuid] = line u;
    } else {
        line moving = 0;
        line clip = "idle";
        if (sneak == 1) {
            line clip = "crouchIdle";
        } else if (holding == 1) {
            line clip = "stance";
        }
        line u = line clock / animLen(line clip);
    }
    if (line speed > animWalkMin()) {
        rigFaceToward(uuid, line d);
    }
    line base = line clip;

    // An emote plays only while standing still.
    if (global animEmote.hasKeys(uuid)) {
        if (line moving == 1 || line air > 0) {
            global animEmote.remove(uuid);
        } else {
            line e = global animEmote[uuid];
            line t = global animEmoteT[uuid];
            global animEmoteT[uuid] = line t + 1;
            line clip = line e;
            line u = line t / animLen(line e);
            if ((global animMeta[line e] as list)[2] as num == 0 && line t >= animLen(line e)) {
                global animEmote.remove(uuid);
            }
        }
    }

    // An attack plays over everything; a queued click chains the next hit.
    if (global animAct.hasKeys(uuid)) {
        line act = global animAct[uuid];
        line t = global animActT[uuid];
        global animActT[uuid] = line t + 1;
        line clip = line act;
        line u = line t / animLen(line act);
        if (line t + 1 >= animLen(line act)) {
            line step = num.parse(line act.replace("w", "").replace("f", ""));
            global animAct.remove(uuid);
            global animActEnd[uuid] = line clock;
            global animStep[uuid] = line step;
            if (global animNext[uuid] == 1) {
                line kind = "f";
                if (holding == 1) {
                    line kind = "w";
                }
                line nx = line step % 3 + 1;
                animStartHit(uuid, "%var(kind)%var(nx)");
            }
        }
    }

    line target = animSampleAt(line clip, line u);
    // Walking with an item: the weapon arm from the hold clip.
    if (holding == 1 && line clip == "walk") {
        line hold = animSampleAt("hold", 0);
        for (line jn of global animMask["hold"] as list) {
            line target[line jn as str] = line hold[line jn as str];
        }
    }

    // Crossfade from the last pose when the clip changes. The start pose's
    // root is wrapped, so a finished spin does not unwind.
    if (!global animOut.hasKeys(uuid)) {
        global animOut[uuid] = line target;
    }
    line changed = 1;
    if (global animClipNow.hasKeys(uuid)) {
        if (global animClipNow[uuid] == line clip) {
            line changed = 0;
        }
    }
    if (line changed == 1) {
        line from = global animOut[uuid];
        line r0 = line from["root"] as vec;
        line from["root"] = vec(animWrap(line r0.x), animWrap(line r0.y), animWrap(line r0.z));
        global animFrom[uuid] = line from;
        global animFadeT[uuid] = 0;
        global animClipNow[uuid] = line clip;
    }
    line ft = animGet(global animFadeT, uuid, 0) + 1;
    global animFadeT[uuid] = line ft;
    line fade = (global animMeta[line clip] as list)[4] as num;
    line out = line target;
    if (line ft < line fade) {
        line w = line ft / line fade;
        line w = line w * line w * (3 - 2 * line w);
        line from = global animFrom[uuid];
        line out = {};
        for (line key, line v of line target) {
            line fv = line from[line key] as vec;
            line out[line key] = line fv + ((line v as vec) - line fv) * line w;
        }
    }
    global animOut[uuid] = line out;
    if (global animDebug.hasKeys(uuid)) {
        select playersByName(uuid);
        selected.sendActionBar(s"<yellow>%var(clip)</yellow> <gray>u %var(u) · speed %var(speed) · sprint %var(sprint) · sneak %var(sneak) · air %var(air) · item %var(holding)");
        select reset;
    }

    // The head looks where the player looks, relative to the body (MC yaw
    // grows to the right and pitch downward; the neck's y + is left, x + up).
    // (Not while the body spins.)
    line pose = line out;
    line r = line out["root"] as vec;
    if (line clip == "w3") {
        global rigPose[uuid] = line pose;
        return;
    }
    line f = global rigFace[uuid];
    line rel = animWrap(look.y - num.atan2(0 - line f.x, line f.z));
    line ny = num.clamp(0 - line rel - animWrap(line r.y), -70, 70);
    line nx = num.clamp(0 - look.x - animWrap(line r.x), -50, 60);
    line pose["neck"] = (line out["neck"] as vec) + vec(line nx, line ny, 0);
    global rigPose[uuid] = line pose;
}

/** @animdebug: toggles showing the playing clip and the inputs that chose
 * it in the action bar. */
function animDebugToggle {
    line uuid = default.uuid;
    if (global animDebug.hasKeys(line uuid)) {
        global animDebug.remove(line uuid);
        default.sendMessage(s"<gray>Animation debug off.");
    } else {
        global animDebug[line uuid] = 1;
        default.sendMessage(s"<gray>Animation debug on: the action bar shows the clip playing.");
    }
}

/** @e NAME: plays an emote on the player's model. */
function animEmoteCommand(words: list) {
    line uuid = default.uuid;
    if (rigHas(line uuid) == 0) {
        default.sendMessage(s"<red>No model up.</red> <gray>Type <yellow>@rig</yellow> first.");
        return;
    }
    if (words.len() < 2 || animEmotes().find(words[2] as str) == 0) {
        line names = animEmotes().join(", ");
        default.sendMessage(s"<gray>Usage: <yellow>@e NAME</yellow>. Emotes: %var(names).");
        return;
    }
    animPlayEmote(line uuid, words[2] as str);
}

playerevent leftClick {
    line uuid = default.uuid;
    if (rigHas(line uuid) == 1) {
        animAttack(line uuid, animHoldsItem(default.mainHandItem));
    }
}
